#!/usr/bin/env bash
# sd: plan, describe and render a recording from the terminal. (The app records; `sd import` brings
# in a video recorded elsewhere.)
#
# analyze, plan, describe and render run the Swift `director` (the macOS app's engine), rebuilding
# it first when its sources changed (`swift build -c release --package-path macos --product director`).
#
#   sd import <name> <video> [--camera <file> [--camera-offset <sec>]]
#   sd analyze <name>             transcribe (Whisper) and measure screen motion
#   sd plan <name> [--force]      write a first-draft plan.json
#   sd describe <name>            print the plan as a readable timeline
#   sd render <name> [out.mp4]    render the final video (default <project>/<name>.mp4)
#   sd auto <name>                analyze + plan + render
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PROJECTS="${SD_PROJECTS:-$ROOT/projects}"
# SD_DIRECTOR (tests) runs a prebuilt director as is.
DIRECTOR="${SD_DIRECTOR:-}"

die() { echo "sd: $*" >&2; exit 1; }
director() {
  if [ -z "$DIRECTOR" ]; then
    # A no-op when nothing changed, so sd never runs a stale build.
    swift build -c release --package-path "$ROOT/macos" --product director >&2
    "$ROOT/macos/.build/release/director" "$@"
  else
    "$DIRECTOR" "$@"
  fi
}
project_dir() { [ -n "${1:-}" ] || die "missing project name"; echo "$PROJECTS/$1"; }
need_project() { [ -f "$1/source.json" ] || die "no project at $1 (record it in the app, or sd import)"; }

write_source() { # dir video [cameraVideo cameraOffset]
  local dir=$1 video=$2 cam=${3:-} off=${4:-0}
  local w h d
  IFS=, read -r w h < <(ffprobe -v error -select_streams v:0 -show_entries stream=width,height -of csv=p=0 "$dir/$video")
  d=$(ffprobe -v error -show_entries format=duration -of csv=p=0 "$dir/$video")
  {
    printf '{\n  "video": "%s",\n  "width": %s,\n  "height": %s,\n  "duration": %s' "$video" "$w" "$h" "$d"
    [ -n "$cam" ] && printf ',\n  "camera": { "video": "%s", "offset": %s }' "$cam" "$off"
    printf '\n}\n'
  } > "$dir/source.json"
}

cmd_import() {
  local name=${1:-} video=${2:-}; shift 2 || die "usage: sd import <name> <video> [--camera <file> [--camera-offset <sec>]]"
  local cam="" off=0
  while [ $# -gt 0 ]; do
    case $1 in
      --camera) cam=$2; shift 2 ;;
      --camera-offset) off=$2; shift 2 ;;
      *) die "unknown option $1" ;;
    esac
  done
  [ -f "$video" ] || die "no such file: $video"
  local dir; dir=$(project_dir "$name")
  [ -e "$dir" ] && die "$dir already exists"
  mkdir -p "$dir"
  local ext="${video##*.}"
  cp -c "$video" "$dir/screen.$ext" 2>/dev/null || cp "$video" "$dir/screen.$ext"
  if [ -n "$cam" ]; then
    cp -c "$cam" "$dir/camera.${cam##*.}" 2>/dev/null || cp "$cam" "$dir/camera.${cam##*.}"
    write_source "$dir" "screen.$ext" "camera.${cam##*.}" "$off"
  else
    write_source "$dir" "screen.$ext"
  fi
  echo "Imported to $dir (no input events, so zooms come from Claude, not clicks)."
}

# analyze, plan, describe, render: director's command on the named project, with any further arguments.
cmd_director() {
  local command=$1 dir; dir=$(project_dir "${2:-}"); need_project "$dir"
  director "$command" "$dir" "${@:3}"
}

cmd_auto() {
  cmd_director analyze "${1:-}"
  cmd_director plan "${1:-}" --force
  cmd_director describe "${1:-}"
  cmd_director render "${1:-}"
}

cmd=${1:-help}; shift || true
case $cmd in
  import|auto) "cmd_$cmd" "$@" ;;
  analyze|plan|describe|render) cmd_director "$cmd" "$@" ;;
  *) sed -n '2,13p' "$0" | sed 's/^# \{0,1\}//' ;;
esac
