#!/usr/bin/env bash
# sd: plan, describe and render a recording from the terminal. (The app records; `sd import` brings
# in a video recorded elsewhere.)
#
# analyze, plan, draft, describe and render run the Swift `director` (the macOS app's engine), rebuilding
# it first when its sources changed (`swift build -c release --package-path macos --product director`).
#
#   sd import <name> <video> [--camera <file> [--camera-offset <sec>]]
#   sd analyze <name>             transcribe (Whisper) and measure screen motion
#   sd plan <name> [--force]      write a first-draft plan.json (the planner alone)
#   sd draft <name> [--force]     the app's first draft: plan plus your default profile and settings
#   sd describe <name>            print the plan as a readable timeline
#   sd render <name> [out.mp4]    render the final video (default <project>/publish/<name> <width>x<height>.mp4)
#   sd auto <name>                analyze + draft + render
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PROJECTS="${SD_PROJECTS:-$ROOT/projects}"
# SD_DIRECTOR (tests) runs a prebuilt director as is.
DIRECTOR="${SD_DIRECTOR:-}"

die() { echo "sd: $*" >&2; exit 1; }
director() { "${DIRECTOR:-$ROOT/bin/director}" "$@"; }
project_dir() { [ -n "${1:-}" ] || die "missing project name"; echo "$PROJECTS/$1"; }
need_project() { [ -f "$1/source.json" ] || die "no project at $1 (record it in the app, or sd import)"; }

# A media file's extension, from its name only: letters and digits, since it lands in source.json
# (a quote in a downloaded file's name would otherwise end the JSON string).
media_ext() {
  local base; base=$(basename "$1")
  local ext="${base##*.}"
  [[ "$base" == *.* && "$ext" =~ ^[A-Za-z0-9]+$ ]] || die "can't tell the video type of $base: rename it to end in .mp4 or .mov"
  printf '%s' "$ext"
}

write_source() { # dir video [cameraVideo cameraOffset]
  local dir=$1 video=$2 cam=${3:-} off=${4:-0}
  local w h d
  # Only local files: a playlist named like a video mustn't make ffprobe open others.
  IFS=, read -r w h < <(ffprobe -v error -protocol_whitelist file -select_streams v:0 -show_entries stream=width,height -of csv=p=0 "$dir/$video")
  d=$(ffprobe -v error -protocol_whitelist file -show_entries format=duration -of csv=p=0 "$dir/$video")
  {
    printf '{\n  "video": "%s",\n  "width": %s,\n  "height": %s,\n  "duration": %s' "$video" "$w" "$h" "$d"
    [ -n "$cam" ] && printf ',\n  "camera": { "video": "%s", "offset": %s }' "$cam" "$off"
    printf '\n}\n'
  } > "$dir/source.json"
}

cmd_import() {
  local name=${1:-} video=${2:-}; shift 2 || die "usage: sd import <name> <video> [--camera <file> [--camera-offset <sec>]]"
  local cam="" off=0
  while [ $# -gt 0 ]; do
    case $1 in
      --camera) cam=$2; shift 2 ;;
      --camera-offset) off=$2; shift 2 ;;
      *) die "unknown option $1" ;;
    esac
  done
  [ -f "$video" ] || die "no such file: $video"
  [[ "$off" =~ ^-?[0-9]+(\.[0-9]+)?$ ]] || die "--camera-offset takes seconds, like 0.25"
  local ext camext=""; ext=$(media_ext "$video")
  [ -n "$cam" ] && camext=$(media_ext "$cam")
  local dir; dir=$(project_dir "$name")
  [ -e "$dir" ] && die "$dir already exists"
  mkdir -p "$dir"
  cp -c "$video" "$dir/screen.$ext" 2>/dev/null || cp "$video" "$dir/screen.$ext"
  if [ -n "$cam" ]; then
    cp -c "$cam" "$dir/camera.$camext" 2>/dev/null || cp "$cam" "$dir/camera.$camext"
    write_source "$dir" "screen.$ext" "camera.$camext" "$off"
  else
    write_source "$dir" "screen.$ext"
  fi
  echo "Imported to $dir (no input events, so zooms come from Claude, not clicks)."
}

# analyze, plan, describe, render: director's command on the named project, with any further arguments.
cmd_director() {
  local command=$1 dir; dir=$(project_dir "${2:-}"); need_project "$dir"
  director "$command" "$dir" "${@:3}"
}

cmd_auto() {
  cmd_director analyze "${1:-}"
  cmd_director draft "${1:-}" --force
  cmd_director describe "${1:-}"
  cmd_director render "${1:-}"
}

cmd=${1:-help}; shift || true
case $cmd in
  import|auto) "cmd_$cmd" "$@" ;;
  analyze|plan|draft|describe|render) cmd_director "$cmd" "$@" ;;
  *) sed -n '2,14p' "$0" | sed 's/^# \{0,1\}//' ;;
esac
